# LLM Enhanced Mode configuration (optional).
# The app runs fully offline in Template Engine Mode without any of these.
# Copy this file to ".env" and fill in your key. NEVER commit your real .env.

# Your provider API key. Leave unset to use Template Engine Mode.
LLM_API_KEY=your-api-key-here

# Which backend to use. Options:
#   gemini | google  -> Google Gemini   (implemented)
#   openai           -> OpenAI          (example seam)
#   azure            -> Azure OpenAI    (example seam)
#   anthropic        -> Anthropic Claude(example seam)
LLM_PROVIDER=gemini

# Model name. Sensible per-provider defaults are used if unset:
#   gemini    -> gemini-2.0-flash
#   openai    -> gpt-4o-mini
LLM_MODEL=gemini-2.0-flash
